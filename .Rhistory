geom_line(colour = low_level_colors["Flux"], linewidth = 1) +
labs(x = NULL, y = "Flux") +
scale_y_continuous(breaks = even_breaks(4), labels = scales::label_number(accuracy = 1)) +
theme_minimal() + theme(axis.text.x = element_blank())
p_modband_4.5 <- ggplot(df, aes(x = second_in_stim, y = modband_4.5)) +
geom_line(colour = modspec_colors["4.5"], linewidth = 1) +
scale_y_continuous(breaks = even_breaks(4), labels = scales::label_number(accuracy = 1)) +
