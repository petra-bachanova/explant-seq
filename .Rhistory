geom_line(colour = modspec_colors["80.0"]) +
scale_y_continuous(breaks = even_breaks(4), labels = scales::label_number(accuracy = 1)) +
labs(x = "Time (s)", y = "80Hz modspec") +
theme_minimal()
combined <- p_rms / p_centroid / p_flux / p_modband_4.5 / p_modband_10 / p_modband_20 /
p_modband_40 / p_modband_80 + plot_annotation(title = stim)
ggsave(glue("{acoustic_analysis_path}/plots/{stim}_features.png"), combined, width = 6, height = 6.5, dpi = 500)
print(combined)
}
