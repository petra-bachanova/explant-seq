library(librarian)
librarian::shelf(readxl, dplyr, ggplot2, lme4, performance, glue, tidyr, tibble)
project_dir <- "~/Documents/repos/accelerated forgetting/"
epi_day_level <- read_xlsx(glue("{project_dir}/data/intra_alf_behavior.xlsx")) %>%
filter(Subject_Type == "e") %>%
mutate(
Lobe = na_if(Lobe, "NA"),
across(c(Epi_Type, SOZ_Hem, Lobe, Sex), as.factor),
Seizure_Over_Testing_binary = as.integer(Seizure_Over_Testing != 0),
# "Preceding night" spike count: the cumulative window that ends the
# night before each Trial's test. Trial 1 has no preceding sleep night
# on record -> NA. Verified this matches the old csv's SWS_spikes exactly.
SWS_spikes = case_when(
Trial == 1 ~ NA_real_,
Trial == 2 ~ `24hr_h_spikes`,
Trial == 3 ~ `48hr_h_spikes`,
Trial == 4 ~ `72hr_h_spikes`,
Trial == 5 ~ `96hr_h_spikes`
)
) %>%
group_by(ID, Trial) %>%
summarise(
Overall_Accuracy = mean(Accuracy),
Recall_Accuracy  = mean(Accuracy[Q_Type == "recall"]),
Recog_Accuracy   = mean(Accuracy[Q_Type == "recog"]),
across(c(Age, Sex, Epi_Type, SOZ_Hem, Lobe, ASM_Num, Onset_Age,
Seizure_Over_Testing_binary, Seizures_24Hr, num_electrodes,
encoding_h_spikes, SWS_spikes),
~ first(.x)),
.groups = "drop"
)
