# 3 shades of blue (light -> dark) for the low-level digital features,
# 5 shades of red (light -> dark, low -> high frequency) for the modspec bands
low_level_colors <- colorRampPalette(c("#ebb4f0", "#9800a6"))(3)
names(low_level_colors) <- c("RMS", "Centroid", "Flux")
modspec_colors <- colorRampPalette(c("#9de05e", "#053801"))(5)
names(modspec_colors) <- c("4.5", "10.0", "20.0", "40.0", "80.0")
for (stim in stimuli) {
df <- all_data[[stim]]
p_rms <- ggplot(df, aes(x = second_in_stim, y = RMS_1s_bins)) +
geom_line(colour = low_level_colors["RMS"], linewidth = 1) +
labs(x = NULL, y = "RMS") +
scale_y_continuous(breaks = even_breaks(4), labels = scales::label_number(accuracy = 0.01)) +
theme_minimal() + theme(axis.text.x = element_blank())
