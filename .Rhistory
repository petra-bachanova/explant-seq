# distinct, ordered colors for the 5 modspec bands (low -> high frequency),
# separate from RMS/Centroid/Flux's existing colors
modspec_colors <- setNames(viridis(5), c("4.5", "10.0", "20.0", "40.0", "80.0"))
for (stim in stimuli) {
df <- all_data[[stim]]
p1 <- ggplot(df, aes(x = second_in_stim, y = RMS_1s_bins)) +
geom_line(colour = "#378ADD") +
labs(x = NULL, y = "RMS") +
scale_y_continuous(breaks = even_breaks(4), labels = scales::label_number(accuracy = 0.01)) +
theme_minimal() + theme(axis.text.x = element_blank())
p2 <- ggplot(df, aes(x = second_in_stim, y = Centroid_1s_bins)) +
geom_line(colour = "#1D9E75") +
labs(x = NULL, y = "Centroid (Hz)") +
scale_y_continuous(breaks = even_breaks(4), labels = scales::label_number(accuracy = 1)) +
theme_minimal() + theme(axis.text.x = element_blank())
p3 <- ggplot(df, aes(x = second_in_stim, y = Flux_1s_bins)) +
geom_line(colour = "orange") +
labs(x = NULL, y = "Flux") +
scale_y_continuous(breaks = even_breaks(4), labels = scales::label_number(accuracy = 1)) +
theme_minimal() + theme(axis.text.x = element_blank())
p_4.5 <- ggplot(df, aes(x = second_in_stim, y = modband_4.5)) +
geom_line(colour = modspec_colors["4.5"]) +
scale_y_continuous(breaks = even_breaks(4), labels = scales::label_number(accuracy = 1)) +
labs(x = NULL, y = "4.5Hz modspec") +
theme_minimal() + theme(axis.text.x = element_blank())
p_10 <- ggplot(df, aes(x = second_in_stim, y = modband_10.0)) +
geom_line(colour = modspec_colors["10.0"]) +
scale_y_continuous(breaks = even_breaks(4), labels = scales::label_number(accuracy = 1)) +
labs(x = NULL, y = "10Hz modspec") +
theme_minimal() + theme(axis.text.x = element_blank())
p_20 <- ggplot(df, aes(x = second_in_stim, y = modband_20.0)) +
geom_line(colour = modspec_colors["20.0"]) +
scale_y_continuous(breaks = even_breaks(4), labels = scales::label_number(accuracy = 1)) +
labs(x = NULL, y = "20Hz modspec") +
theme_minimal() + theme(axis.text.x = element_blank())
p4 <- ggplot(df, aes(x = second_in_stim, y = modband_40.0)) +
geom_line(colour = modspec_colors["40.0"]) +
scale_y_continuous(breaks = even_breaks(4), labels = scales::label_number(accuracy = 1)) +
labs(x = NULL, y = "40Hz modspec") +
theme_minimal() + theme(axis.text.x = element_blank())
p5 <- ggplot(df, aes(x = second_in_stim, y = modband_80.0)) +
geom_line(colour = modspec_colors["80.0"]) +
scale_y_continuous(breaks = even_breaks(4), labels = scales::label_number(accuracy = 1)) +
labs(x = "Time (s)", y = "80Hz modspec") +
theme_minimal()
combined <- p1 / p2 / p3 / p_4.5 / p_10 / p_20 / p4 / p5 + plot_annotation(title = stim)
ggsave(glue("{acoustic_analysis_path}/plots/{stim}_features.png"), combined, width = 6, height = 6.5, dpi = 500)
print(combined)
}
even_breaks <- function(n = 4) {
function(x) seq(min(x, na.rm = TRUE), max(x, na.rm = TRUE), length.out = n)
}
