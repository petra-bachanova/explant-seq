library(tidyverse)
library(glmmTMB)
project_path <- "/Volumes/ECoG/k448_tempo_study"
fs <- 200  # Hz, used only for spike samples -> seconds
participants <- read_tsv(file.path(project_path, "rawdata", "participants.tsv"))
sessions <- read_tsv(file.path(project_path, "rawdata", "sessions.tsv")) %>% filter(exclude == 0)
meta <- left_join(sessions, participants, by = "participant_id")
meta$ID <- paste0(meta$participant_id, "_", meta$session)
load_spikes <- function(participant_id, session) {
path <- file.path(project_path, "derivatives", "spike_detection",
participant_id, session,
paste0(participant_id, "_", session, "_spike_detection_all_spikes.xlsx"))
spikes <- readxl::read_excel(path)
spikes$spike_time_s <- spikes$spike_start / fs
spikes
}
load_time_markers <- function(participant_id, session) {
path <- file.path(project_path, "derivatives", "time_markers",
participant_id, session,
paste0(participant_id, "_", session, "_processed_time_markers.csv"))
read_csv(path, show_col_types = FALSE)
}
bin_spikes_for_event <- function(spikes, event_row) {
start_s <- floor(event_row$start_time)
end_s   <- floor(event_row$end_time)
bins <- tibble(second_in_stim = 0:(end_s - start_s - 1))
bins$spike_count <- sapply(bins$second_in_stim, function(s) {
b0 <- start_s + s
sum(spikes$spike_time_s >= b0 & spikes$spike_time_s < b0 + 1)
})
bins
}
load_acoustic <- function(stimulus_name) {
path <- file.path(project_path, "derivatives", "acoustic_ft_analysis",
paste0(stimulus_name, ".csv"))
af <- read_csv(path, show_col_types = FALSE)
names(af)[1] <- "second_in_stim"
af
}
make_offsets <- function(df, features = c("RMS_1s_bins", "Centroid_1s_bins", "Flux_1s_bins"),
offsets = c(0, 4, 16)) {
for (feat in features) {
for (off in offsets) {
df[[paste0(feat, "_lag", off)]] <- lag(df[[feat]], off)
}
}
df
}
sp <- load_spikes("sub-17", "ses-01")
tm <- load_time_markers("sub-17", "ses-01")
event_row <- tm %>% filter(event == "K448_136BPM")
bins <- bin_spikes_for_event(sp, event_row)
sum(bins$spike_count)
sp %>% filter(spike_time_s >= event_row$start_time & spike_time_s < event_row$end_time) %>% nrow()
# these two numbers must match before proceeding
af <- load_acoustic("K448_136BPM")
merged <- left_join(bins, af, by = "second_in_stim")
merged <- make_offsets(merged)
m0 <- glm(spike_count ~ RMS_1s_bins_lag4 + Centroid_1s_bins_lag4 + Flux_1s_bins_lag4,
data = merged, family = poisson())
summary(m0)
View(merged)
head(merged)
missing_acoustic <- character()
all_data <- list()
for (id in meta$ID) {
participant_id <- meta$participant_id[meta$ID == id]
session        <- meta$session[meta$ID == id]
sp <- tryCatch(load_spikes(participant_id, session), error = function(e) NULL)
tm <- tryCatch(load_time_markers(participant_id, session), error = function(e) NULL)
if (is.null(sp) || is.null(tm)) next
stim_events <- tm %>%
filter(!str_detect(event, "baseline|GAP|TALKING|SART")) %>%
filter(!str_detect(event, regex("COLDPLAY|K448_MONO", ignore_case = TRUE)))
for (i in seq_len(nrow(stim_events))) {
event_row <- stim_events[i, ]
stim_name <- event_row$event
af_path <- file.path(project_path, "derivatives", "acoustic_ft_analysis",
paste0(stim_name, ".csv"))
if (!file.exists(af_path)) {
missing_acoustic <- c(missing_acoustic, stim_name)
next
}
bins <- bin_spikes_for_event(sp, event_row)
af <- load_acoustic(stim_name)
merged <- left_join(bins, af, by = "second_in_stim")
merged <- make_offsets(merged)
merged$ID <- id
merged$piece <- stim_name
all_data[[paste(id, stim_name)]] <- merged
}
}
full_df <- bind_rows(all_data)
sort(unique(missing_acoustic))  # inspect before trusting full_df
full_df %>% count(piece)
full_df %>% count(ID)
full_df <- full_df %>%
group_by(piece) %>%
mutate(across(matches("_lag[0-9]+$"), ~ . - mean(., na.rm = TRUE), .names = "{.col}_c")) %>%
ungroup() %>%
mutate(across(matches("_lag[0-9]+_c$"), ~ . / sd(., na.rm = TRUE), .names = "{.col}_z"))
pooled_model <- glmmTMB(
spike_count ~ RMS_1s_bins_lag0_c_z + Centroid_1s_bins_lag0_c_z + Flux_1s_bins_lag0_c_z +
RMS_1s_bins_lag4_c_z + Centroid_1s_bins_lag4_c_z + Flux_1s_bins_lag4_c_z +
RMS_1s_bins_lag16_c_z + Centroid_1s_bins_lag16_c_z + Flux_1s_bins_lag16_c_z +
piece +
(1 | ID),
data = full_df,
family = nbinom2()
)
summary(pooled_model)
full_df <- full_df %>%
mutate(spike_present = as.integer(spike_count > 0))
full_df %>% count(spike_count)
spike_freqs <- full_df %>% count(spike_count)
ggplot(data=spike_freqs, aes(x=spike_count, y=n)) + geom_col()
pooled_model_binary <- glmmTMB(
spike_present ~ RMS_1s_bins_lag0_c_z + Centroid_1s_bins_lag0_c_z + Flux_1s_bins_lag0_c_z +
RMS_1s_bins_lag4_c_z + Centroid_1s_bins_lag4_c_z + Flux_1s_bins_lag4_c_z +
RMS_1s_bins_lag16_c_z + Centroid_1s_bins_lag16_c_z + Flux_1s_bins_lag16_c_z +
piece + (1 | ID),
data = full_df,
family = binomial()
)
summary(pooled_model_binary)
library(broom.mixed)
tidy_binary <- tidy(pooled_model_binary, effects = "fixed", conf.int = TRUE) %>%
mutate(model = "Binary (spike present)")
tidy_count <- tidy(pooled_model, effects = "fixed", conf.int = TRUE) %>%
mutate(model = "Count (NB)")
coefs <- bind_rows(tidy_binary, tidy_count) %>%
filter(term != "(Intercept)") %>%
mutate(
or_irr = exp(estimate),
conf.low = exp(conf.low),
conf.high = exp(conf.high),
term_clean = str_remove(term, "_1s_bins|_c_z") %>% str_replace("_lag", " lag "),
significant = conf.low > 1 | conf.high < 1
)
ordered_terms <- c(
"pieceWAGNER",
"pieceK448_166BPM",
"pieceK448_136BPM",
"pieceK448_106BPM",
"RMS lag 16_c_z",
"RMS lag 4_c_z",
"RMS lag 0_c_z",
"Centroid lag 16_c_z",
"Centroid lag 4_c_z",
"Centroid lag 0_c_z",
"Flux lag 16_c_z",
"Flux lag 4_c_z",
"Flux lag 0_c_z"
)
coefs <- coefs %>%
mutate(term_clean = factor(term_clean, levels = ordered_terms))
ggplot(coefs, aes(x = or_irr, y = term_clean, color = significant, shape = model)) +
geom_vline(xintercept = 1, linetype = "dashed", color = "grey50") +
geom_pointrange(aes(xmin = conf.low, xmax = conf.high),
position = position_dodge(width = 0.4)) +
scale_color_manual(values = c(`TRUE` = "#D10056", `FALSE` = "grey70"),
guide = "none") +
scale_shape_manual(values = c(16, 17)) +
scale_x_log10(breaks = c(0.7, 0.8, 0.9, 1, 1.1, 1.2, 1.3)) +
labs(x = "Odds Ratio / Incidence Rate Ratio (log scale)", y = NULL, shape = "Model",
title = "Effect of acoustic features and piece on IED likelihood/count") +
theme_minimal() + theme(panel.grid.major = element_blank(), panel.grid.minor = element_blank())
