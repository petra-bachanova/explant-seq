process {
    executor       = 'slurm'
    queue          = 'standard'
    clusterOptions = '--mail-type=FAIL'
    resourceLimits = [ cpus: 10, memory: 128.GB, time: 48.h ]

    withName: 'BWAMEM1_MEM' {
        cpus   = 6
        memory = 24.GB
        time   = { 1.h * task.attempt }
    }
}

executor {
    queueSize       = 10
    submitRateLimit = '5 sec'
}
